APP_NAME="ISP Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isp_automation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="billing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila

# --- Brevo (set MAIL_MAILER=brevo above; MAIL_FROM_ADDRESS must be a sender verified in Brevo)
BREVO_KEY=

# --- PayMongo (test keys first: sk_test_... / pk_test_...)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Only methods activated on your PayMongo account for this mode
PAYMONGO_METHODS=qrph,gcash,paymaya,card

# --- MikroTik RouterOS API (/ip service: api = 8728, api-ssl = 8729)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_SSL=false
MIKROTIK_USERNAME=billing
MIKROTIK_PASSWORD=
MIKROTIK_TIMEOUT=10
# A PPP secret on your test router, for the demo subscriber the seeder creates
MIKROTIK_TEST_USER=

# --- Billing rules (days)
ISP_INVOICE_LEAD_DAYS=7
ISP_REMINDER_DAYS=3
ISP_GRACE_DAYS=0
# disable = disable the secret | profile = move to ISP_SUSPENDED_PROFILE (walled garden)
ISP_SUSPEND_MODE=disable
ISP_SUSPENDED_PROFILE=suspended

# --- First admin login (used by `php artisan db:seed`)
ADMIN_EMAIL=admin@isp.test
ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=

# Set to * when behind Railway / ngrok so rate limits see the real client IP
TRUSTED_PROXIES=
