# Live settings for compose.production.yaml.
# Copy to .env.production (never commit that file — it's in .gitignore) and
# fill in every value marked REQUIRED.
#
# Generate APP_KEY with:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

# --- App
APP_NAME="ISP Automation"
APP_ENV=production
APP_DEBUG=false
# REQUIRED: base64:... (see above). Keep it forever: changing it signs everyone out.
APP_KEY=
# REQUIRED: the public address from your Cloudflare Tunnel, e.g. https://billing.yourdomain.com
APP_URL=
APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Behind the Cloudflare Tunnel: real visitor IPs for the rate limits, https links.
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Database (the db service in compose.production.yaml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=isp_automation
DB_USERNAME=isp
# REQUIRED: two different long random passwords.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- First admin login (created once on first start; change it later with "Forgot password")
ADMIN_EMAIL=admin@yourdomain.com
# REQUIRED: 8+ characters with upper- and lowercase, a number and a symbol.
ADMIN_PASSWORD=qwerty123

# --- Cloudflare Tunnel (public https address)
# Trying it out: leave TUNNEL_TOKEN empty and start with the quick tunnel
# (.\docker\production.ps1 start -Quick) — a free random trycloudflare.com address.
# Going live: Cloudflare dashboard → Zero Trust → Networks → Tunnels → Create tunnel
# (type Cloudflared) → copy the token. Public hostname: your domain → http://app:80
TUNNEL_TOKEN=

# Port for opening the app on this PC only: http://localhost:8080
APP_PORT=8080

# --- MikroTik RouterOS API (reached over the office LAN)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_SSL=false
MIKROTIK_SSL_VERIFY=false
MIKROTIK_USERNAME=billing
# REQUIRED: the password of the router's "billing" API user.
MIKROTIK_PASSWORD=
MIKROTIK_TIMEOUT=10

# --- Billing rules (days)
ISP_INVOICE_LEAD_DAYS=7
ISP_REMINDER_DAYS=3
ISP_GRACE_DAYS=0
# disable = disable the PPPoE secret | profile = move to ISP_SUSPENDED_PROFILE (walled garden)
ISP_SUSPEND_MODE=disable
ISP_SUSPENDED_PROFILE=suspended

# --- PayMongo (test keys first: sk_test_... / pk_test_...; live keys after verification)
# Webhook URL to register in PayMongo: {APP_URL}/webhooks/paymongo
#   event: checkout_session.payment.paid
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=qrph,gcash,paymaya,card

# --- Email (bills, reminders, cut-off and reconnect notices, sign-in codes)
# Brevo has a free tier: brevo.com → SMTP & API → API keys. The sender address
# must be verified in Brevo.
MAIL_MAILER=brevo
BREVO_KEY=
MAIL_FROM_ADDRESS=billing@yourdomain.com
# Same as APP_NAME (written out: Docker doesn't expand variables in this file).
MAIL_FROM_NAME="ISP Automation"

# --- Daily database backup (the "backup" service)
# Folder on this PC for the backup files. Point it at a synced folder (e.g. a
# OneDrive / Google Drive folder) so copies also leave this PC.
BACKUP_DIR=./backups
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14

# --- Front page contact details (empty = hidden)
ISP_CONTACT_PHONE=
ISP_CONTACT_EMAIL=
ISP_CONTACT_ADDRESS=
ISP_OFFICE_HOURS=
